# Environment Configuration

# Blockchain Network
POLYGON_RPC=https://polygon-rpc.com
HOODI_DEPLOY_RPC=https://hoodi.infura.io/v3/your_infura_api_key
RPC_URL=http://localhost:8545
CHAIN_ID=31337
PRIVATE_KEY=your_private_key_here
HOODI_API_KEY=your_hoodi_api_key

# Contract Addresses (populated after deployment)
IDENTITY_TOKEN_ADDRESS=0x_your_identity_token_address
TRANSACTION_REGISTRY_ADDRESS=0x_your_transaction_registry_address
ACCESS_CONTROL_ADDRESS=0x_your_access_control_address
DOCUSIGN_REGISTRY_ADDRESS=0x_your_document_signature_registry_address

# Backend Configuration
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/kyc-kyb-platform

# IPFS Configuration
# Preferred production storage: Pinata
# Used by the envelope service for source PDFs, rendered PDFs, and signature PNGs.
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Self-hosted / direct IPFS node
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http

# Alternative: Use Infura IPFS
# IPFS_PROJECT_ID=your_infura_project_id
# IPFS_PROJECT_SECRET=your_infura_secret

# Storage behavior notes:
# 1. If PINATA_API_KEY and PINATA_SECRET_KEY are set, backend will prefer Pinata.
# 2. Otherwise it will try direct IPFS using IPFS_HOST / IPFS_PORT / IPFS_PROTOCOL.
# 3. In production, raw document upload fails closed if durable storage is not configured.

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
# Master encryption key (MUST be a strong 64-char hex string in production)
MASTER_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# JWT & Session (MUST be strong random strings in production)
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=31337

# AWS S3 (Optional alternative to IPFS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=kyc-kyb-documents

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
