HOODI_RPC=https://hoodi.infura.io/v3/cd3d776de5944439ac32828023ddc09c
PRIVATE_KEY=c4bbd5167fe7d74edc415f4f949ecaada7b7cb62e405ca9b1132de814ac6eb50
HOODI_API_KEY=cd3d776de5944439ac32828023ddc09c

# Contract Addresses (populated after deployment)
IDENTITY_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
TRANSACTION_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
ACCESS_CONTROL_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# Backend Configuration
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/kyc-kyb-platform

# IPFS Configuration
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http
# Alternative: Use Infura IPFS
# IPFS_PROJECT_ID=your_infura_project_id
# IPFS_PROJECT_SECRET=your_infura_secret

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
# Master encryption key (use strong random key in production)
MASTER_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# JWT & Session
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# AWS S3 (Optional alternative to IPFS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=kyc-kyb-documents

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
