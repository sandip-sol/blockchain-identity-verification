# Environment Configuration

# Blockchain Network
POLYGON_MUMBAI_RPC=https://rpc-mumbai.maticvigil.com
POLYGON_RPC=https://polygon-rpc.com
PRIVATE_KEY=your_private_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Contract Addresses (populated after deployment)
IDENTITY_TOKEN_ADDRESS=
TRANSACTION_REGISTRY_ADDRESS=
ACCESS_CONTROL_ADDRESS=

# Backend Configuration
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/kyc-kyb-platform

# IPFS Configuration
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http
# Alternative: Use Infura IPFS
# IPFS_PROJECT_ID=your_infura_project_id
# IPFS_PROJECT_SECRET=your_infura_secret

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
# Master encryption key (use strong random key in production)
MASTER_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# JWT & Session
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# AWS S3 (Optional alternative to IPFS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=kyc-kyb-documents

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
