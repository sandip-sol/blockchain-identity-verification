# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_TIMEOUT=30000

# Blockchain Configuration
# Blockchain Configuration
# NEXT_PUBLIC_CHAIN_ID=1337
# NEXT_PUBLIC_NETWORK_NAME=localhost

# Hoodi Testnet
NEXT_PUBLIC_CHAIN_ID=560048
NEXT_PUBLIC_NETWORK_NAME=hoodi
NEXT_PUBLIC_RPC_URL=https://hoodi.infura.io/v3/API_KEY

# Contract Addresses (fill after deployment)
NEXT_PUBLIC_IDENTITY_TOKEN_ADDRESS=
NEXT_PUBLIC_TRANSACTION_REGISTRY_ADDRESS=
NEXT_PUBLIC_DATA_ACCESS_CONTROL_ADDRESS=

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Features
NEXT_PUBLIC_ENABLE_IPFS=true
NEXT_PUBLIC_ENABLE_VERIFICATION=true
